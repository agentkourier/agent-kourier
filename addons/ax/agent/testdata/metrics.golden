# HELP agentkourier_ax_auth_refused_total Requests to the A2A endpoint or the agent card that the caller check refused, by reason: missing (no credential, 401), invalid (not accepted, 401) or unavailable (the OIDC issuer could not be reached, 503).
# TYPE agentkourier_ax_auth_refused_total counter
agentkourier_ax_auth_refused_total{reason="invalid"}
agentkourier_ax_auth_refused_total{reason="missing"}
agentkourier_ax_auth_refused_total{reason="unavailable"}
# HELP agentkourier_ax_forwarded_requests_total Requests to the A2A endpoint or the agent card that this replica, a standby, forwarded or could not, by outcome: forwarded, failed, cancelled, no_leader or loop.
# TYPE agentkourier_ax_forwarded_requests_total counter
agentkourier_ax_forwarded_requests_total{outcome="cancelled"}
agentkourier_ax_forwarded_requests_total{outcome="failed"}
agentkourier_ax_forwarded_requests_total{outcome="forwarded"}
agentkourier_ax_forwarded_requests_total{outcome="loop"}
agentkourier_ax_forwarded_requests_total{outcome="no_leader"}
# HELP agentkourier_ax_leader 1 while this replica runs turns (it leads, or it is the only replica: SQLite), 0 while it is a standby.
# TYPE agentkourier_ax_leader gauge
agentkourier_ax_leader
# HELP agentkourier_ax_leader_takeovers_total Times this replica took the lease, each with a new epoch.
# TYPE agentkourier_ax_leader_takeovers_total counter
agentkourier_ax_leader_takeovers_total
# HELP agentkourier_ax_message_replays_total Messages whose ID the store had recorded, which joined that message's task instead of starting another turn.
# TYPE agentkourier_ax_message_replays_total counter
agentkourier_ax_message_replays_total
# HELP agentkourier_ax_operation_duration_seconds Duration of the agent's calls to its model's provider, Amazon Bedrock (converse, converse_stream) or the Anthropic API (messages_stream), a stream timed while it opens, by outcome: success, cancelled, timeout, the HTTP status the provider answered, or error.
# TYPE agentkourier_ax_operation_duration_seconds histogram
agentkourier_ax_operation_duration_seconds{operation="converse",outcome="success"}
agentkourier_ax_operation_duration_seconds{operation="converse_stream",outcome="success"}
agentkourier_ax_operation_duration_seconds{operation="messages_stream",outcome="success"}
# HELP agentkourier_ax_sessions_deleted_total ADK sessions the agent deleted, each with its context's tasks, by reason: idle (no activity for SESSION_IDLE_TTL).
# TYPE agentkourier_ax_sessions_deleted_total counter
agentkourier_ax_sessions_deleted_total{reason="idle"}
# HELP agentkourier_ax_tasks_interrupted_total Tasks left submitted or working by a restart or a takeover, which the leader failed when it began to lead.
# TYPE agentkourier_ax_tasks_interrupted_total counter
agentkourier_ax_tasks_interrupted_total
# HELP agentkourier_ax_turns_total Turns the agent ran, by how they ended: completed, input_required (paused on an ask_user question), failed, canceled or interrupted (failed by the leader after a restart or a takeover).
# TYPE agentkourier_ax_turns_total counter
agentkourier_ax_turns_total{outcome="canceled"}
agentkourier_ax_turns_total{outcome="completed"}
agentkourier_ax_turns_total{outcome="failed"}
agentkourier_ax_turns_total{outcome="input_required"}
agentkourier_ax_turns_total{outcome="interrupted"}
