{
  "actor": {"atespace": "agent-kourier-ax", "name": "assistant"},
  "egressPolicy": {
    "metadata": {"atespace": "agent-kourier-ax", "name": "default"},
    "rules": [
      {"hostnames": {
        "patterns": ["bedrock-runtime.us-east-1.amazonaws.com"],
        "effects": {"injectStaticHeaders": [{
          "header": "Authorization", "prefix": "Bearer ",
          "credentialUri": "ate-secret://YOUR_PROVIDER_CLASS/YOUR_PROVIDER_NAME/YOUR_SECRET_REFERENCE"
        }]}
      }},
      {"hostnames": {"patterns": ["YOUR_ISSUER_HOST"]}}
    ]
  }
}
