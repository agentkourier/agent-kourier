{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "dockerfile",
    "pip-compile",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go modules"
    },
    {
      "description": "goldmark v2 is an API rewrite; the test-only CommonMark scanner in internal/chat/chattest stays on v1",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/yuin/goldmark"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Agent Kourier's own image: the digests in hack/security/test.sh are fake fixtures, and a release stamps the real one",
      "matchDepNames": [
        "ghcr.io/agentkourier/agent-kourier"
      ],
      "enabled": false
    },
    {
      "description": "kagent's Go ADK runtime is pinned by digest alone, to the build the pinned kagent release ships; it moves by hand with KAGENT_VERSION in hack/kind/up-full.sh",
      "matchDepNames": [
        "ghcr.io/kagent-dev/kagent/golang-adk"
      ],
      "enabled": false
    },
    {
      "description": "The kind fast tier's Postgres stays on major 17: its manifest mounts the data directory where 17 keeps it, and 18 moved it. hack/postgres/test.sh moves majors on its own",
      "matchFileNames": [
        "hack/kind/fast/postgres.yaml"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "matchManagers": [
        "dockerfile",
        "custom.regex"
      ],
      "groupName": "container base images",
      "digest": {
        "enabled": true
      }
    },
    {
      "matchManagers": [
        "pip-compile"
      ],
      "groupName": "documentation Python dependencies",
      "matchFileNames": [
        "hack/docs/**"
      ]
    },
    {
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        "examples/recipes/echo-agent/**"
      ],
      "groupName": "echo-agent Python dependencies"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)hack/docs/requirements\\.txt$/",
      "/(^|/)examples/recipes/echo-agent/agent/requirements(-dev)?\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hack\\/.*\\.sh$/",
        "/^hack\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|[=\\s\"'])(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "(?:^|[=\\s\"'])(?<depName>[a-z0-9][a-z0-9./_-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^hack\\/security\\/govulncheck\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=go depName=golang.org\\/x\\/vuln\\nGOVULNCHECK_VERSION=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "go",
      "depNameTemplate": "golang.org/x/vuln"
    }
  ]
}
