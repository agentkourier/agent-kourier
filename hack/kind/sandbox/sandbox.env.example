# The sandbox tier's secrets (hack/kind/sandbox/README.md). Copy this file to
# ~/.config/agent-kourier/sandbox.env (or wherever SANDBOX_ENV points), fill in every value, and chmod 600 it.
# It is read as plain KEY=VALUE lines and never run as a script, so no quoting or expansion applies. It is
# refused if a value still says REPLACE, or if it is readable by anyone but you.
# Never commit the filled-in file.
#
# The sandbox Slack app's bot token (OAuth & Permissions) and app-level token (Basic Information, scope connections:write).
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_APP_TOKEN=xapp-REPLACE
# The ID of the channel the bot was invited to: open the channel, Channel details, and the ID is at the bottom.
SLACK_CHANNEL_ID=CREPLACE
# The model the sandbox-sre agent runs on, and its API key. MODEL_PROVIDER is anthropic, openai or bedrock.
# For bedrock, change MODEL_PROVIDER, set MODEL_NAME to a model ID or an inference profile ID (for example
# us.anthropic.claude-haiku-4-5-20251001-v1:0), MODEL_API_KEY to a Bedrock API key (a bearer token, not AWS access keys), and
# uncomment MODEL_REGION (required for bedrock, refused for the others), for example us-east-1.
MODEL_PROVIDER=anthropic
MODEL_NAME=REPLACE
MODEL_API_KEY=REPLACE
# MODEL_REGION=us-east-1
