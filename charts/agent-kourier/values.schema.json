{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Agent Kourier chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0, "description": "0 (the kill switch), 1, or 2 or more with store.type postgres: the replicas elect a leader and the others stand by; SQLite is one replica"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"create": {"type": "boolean"}, "name": {"type": "string"}, "annotations": {"type": "object"}}
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "logLevel": {"enum": ["debug", "info", "warn", "error"]},
    "klogVerbosity": {"type": "integer", "minimum": 0, "maximum": 7, "description": "client-go logs response bodies, Secret lists included, at 8 and above"},
    "syncTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
    "auditRetention": {"type": "string", "pattern": "^(keep|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)?$", "description": "empty or keep: audit entries are never purged; else a duration of at least 24h"},
    "extraEnv": {"type": "array"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"enum": ["files", "crds"], "description": "crds (the default): Binding, AgentBackend and ChatConnection custom resources, read from the cluster; files: the ConfigMap route, for a proof of concept"},
        "chatConnection": {"type": "string", "pattern": "^(([a-z0-9]([-a-z0-9]*[a-z0-9])?)/)?[a-z0-9]([-a-z0-9.]*[a-z0-9])?$|^$", "maxLength": 253, "description": "with source crds: the broker's own ChatConnection, namespace/name or name (in the release namespace); empty with connectionNamespaces or connectionNamespaceSelector set is a broker with no connection of its own, and empty with both unset is the one entry of chatConnections, or with no entry a broker that serves every namespace"},
        "chatConnectionSecret": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$|^$", "maxLength": 253, "description": "with source crds: the name of the Secret the served ChatConnection reads, in the connection's namespace, when it is not named like the connection; empty is the connection's own name"},
        "connectionNamespaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}, "description": "with source crds: the namespaces whose ChatConnections this broker serves besides its own, if it has one (the admission list), read at start; each a namespace name"},
        "connectionNamespaceSelector": {"type": ["object", "null"], "additionalProperties": false, "properties": {"matchLabels": {"type": "object", "minProperties": 1, "patternProperties": {"^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$": {"$ref": "#/definitions/labelValue"}}, "additionalProperties": false}, "matchExpressions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/labelSelectorRequirement"}}}, "description": "with source crds: a label selector (matchLabels, matchExpressions) on namespaces whose ChatConnections this broker serves besides its own and the list's, read live; {} selects every namespace, null (the default) is unset"},
        "existingConfigMap": {"type": "string"},
        "agentBackends": {"$ref": "#/definitions/resources"},
        "chatConnections": {"$ref": "#/definitions/resources"},
        "bindings": {"$ref": "#/definitions/resources"},
        "rollOnChange": {"type": "boolean"}
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"install": {"type": ["boolean", "null"], "description": "render the CustomResourceDefinitions of the three kinds, kept on uninstall; unset, it follows the route (true with config.source crds, false with files), and an explicit value wins: true with files is the first step of a move, false with crds is for an installer that may not create a CRD"}}
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["sqlite", "postgres"]},
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dsnSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253},
                "key": {"type": "string", "pattern": "^[-._a-zA-Z0-9]*$", "maxLength": 253}
              }
            },
            "timeouts": {"enum": ["agent-kourier", "role"]}
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leaseDuration": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
        "renewDeadline": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
        "retryPeriod": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"}
      }
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingClaim": {"type": "string"},
        "dbFile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "size": {"type": "string"},
        "storageClassName": {"type": "string"},
        "accessModes": {"type": "array", "items": {"type": "string"}},
        "retainOnUninstall": {"type": "boolean"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "secretNamespaces": {"type": "array", "items": {"type": "string"}},
        "secretNames": {
          "type": "object",
          "description": "with source crds: namespace to the names of the Secrets to grant list and watch on, by resourceNames",
          "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "maxLength": 253}}
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "annotations": {"type": "object"}}
    },
    "chatListener": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"type": "object"}
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "annotations": {"type": "object"},
            "host": {"type": "string"},
            "tls": {"type": "array"}
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string"},
        "labels": {"type": "object"},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "kubeApiServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "ports": {"type": "array", "items": {"type": "integer"}}}
        },
        "dns": {"type": "object"},
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "except": {"type": "array", "items": {"type": "string"}}}
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"to": {"type": "array"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "metricsFrom": {"type": "array"},
        "chatFrom": {"type": "array"},
        "extraEgress": {"type": "array"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": ["integer", "string", "null"]}, "maxUnavailable": {"type": ["integer", "string", "null"]}}
    },
    "tokenRefresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "schedule": {"type": "string"},
        "targetSecret": {"type": "string"},
        "targetKey": {"type": "string", "pattern": "^[-._a-zA-Z0-9]+$"},
        "targetNamespace": {"type": "string"},
        "dex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokenURL": {"type": "string"},
            "clientId": {"type": "string"},
            "scope": {"type": "string"},
            "credentialsSecret": {"type": "string"}
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
          }
        },
        "resources": {"type": "object"}
      }
    },
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cma": {
          "type": "object",
          "additionalProperties": false,
          "description": "the Claude Managed Agents add-on, an A2A server in front of one CMA agent; off by default",
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {"type": "string"},
                "tag": {"type": "string"},
                "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
                "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "replicaCount": {"type": "integer", "minimum": 0, "description": "0 stops the add-on, 1, or 2 or more with store.type postgres: the replicas elect a leader and the standbys forward to it; SQLite is one replica"},
            "agentId": {"type": "string"},
            "environmentId": {"type": "string"},
            "anthropicApiKeySecret": {"$ref": "#/definitions/secretKey"},
            "sessionIdleTTL": {"$ref": "#/definitions/durationOrZero"},
            "toolResultTimeout": {"$ref": "#/definitions/durationOrZero"},
            "taskRetention": {"$ref": "#/definitions/durationOrZero"},
            "logLevel": {"enum": ["debug", "info", "warn", "error"]},
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "description": "the tokens the add-on accepts; the chart offers no way to turn the caller check off",
              "properties": {
                "tokenSecret": {"$ref": "#/definitions/secretKey"},
                "header": {"type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]*$", "maxLength": 256, "not": {"pattern": "^([Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Xx]-[Uu][Ss][Ee][Rr]-[Ii][Dd]|[Xx]-[Aa][Gg][Ee][Nn][Tt]-[Nn][Aa][Mm][Ee]|[Xx]-[Ss][Hh][Aa][Rr][Ee]-[Tt][Oo][Kk][Ee][Nn]|[Xx]-[Kk][Aa][Gg][Ee][Nn][Tt]-[Ii][Nn][Ss][Ee][Cc][Uu][Rr][Ee]-[Rr][Uu][Nn][Tt][Ii][Mm][Ee]-[Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy])$"}, "description": "the header that carries the token; empty is Authorization, with Bearer <token>; never a reserved name Agent Kourier does not fill with a secret (Proxy-Authorization, Cookie, X-User-Id, X-Agent-Name, X-Share-Token, X-Kagent-Insecure-Runtime-Identity), in any case"}
              }
            },
            "store": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {"enum": ["sqlite", "postgres"]},
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"dsnSecret": {"$ref": "#/definitions/secretKey"}}
                }
              }
            },
            "leaderElection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "leaseDuration": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
                "renewDeadline": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
                "retryPeriod": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"}
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": {"type": "string"},
                "size": {"type": "string"},
                "storageClassName": {"type": "string"},
                "accessModes": {"type": "array", "items": {"type": "string"}},
                "retainOnUninstall": {"type": "boolean"}
              }
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "anthropic": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "except": {"type": "array", "items": {"type": "string"}}}
                },
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"to": {"type": "array"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
                },
                "extraEgress": {"type": "array"}
              }
            },
            "extraEnv": {"type": "array"},
            "resources": {"type": "object"},
            "podAnnotations": {"type": "object"},
            "podLabels": {"type": "object"},
            "nodeSelector": {"type": "object"},
            "tolerations": {"type": "array"},
            "affinity": {"type": "object"},
            "podSecurityContext": {"type": "object"},
            "securityContext": {"type": "object"}
          }
        },
        "ax": {
          "type": "object",
          "additionalProperties": false,
          "description": "the AX add-on, an ADK agent on Amazon Bedrock that serves A2A; off by default",
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {"type": "string"},
                "tag": {"type": "string"},
                "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
                "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
              }
            },
            "replicaCount": {"type": "integer", "minimum": 0, "description": "0 stops the add-on, 1, or 2 or more with store.type postgres: the replicas elect a leader and the standbys forward to it; SQLite is one replica"},
            "model": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "provider": {"enum": ["bedrock", "anthropic"], "description": "bedrock (Amazon Bedrock) or anthropic (the Anthropic API)"},
                "region": {"type": "string", "description": "the AWS region of Bedrock; required with bedrock, refused with anthropic"},
                "name": {"type": "string", "description": "the Bedrock model ID or inference profile, or the Anthropic model ID; required"}
              }
            },
            "bedrock": {
              "type": "object",
              "additionalProperties": false,
              "description": "with bedrock, the Bedrock API key, apiKeySecret with both name and key or neither; neither takes AWS credentials from the SDK's default chain; refused with anthropic",
              "properties": {"apiKeySecret": {"$ref": "#/definitions/secretKey"}}
            },
            "anthropicApiKeySecret": {"$ref": "#/definitions/secretKey"},
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"annotations": {"type": "object", "description": "on the add-on's ServiceAccount: an IAM role for IRSA"}}
            },
            "sessionIdleTTL": {"$ref": "#/definitions/durationOrZero"},
            "taskRetention": {"$ref": "#/definitions/durationOrZero"},
            "logLevel": {"enum": ["debug", "info", "warn", "error"]},
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "description": "the tokens the add-on accepts; the chart offers no way to turn the caller check off, and no OIDC",
              "properties": {
                "tokenSecret": {"$ref": "#/definitions/secretKey"},
                "header": {"type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]*$", "maxLength": 256, "not": {"pattern": "^([Pp][Rr][Oo][Xx][Yy]-[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Xx]-[Uu][Ss][Ee][Rr]-[Ii][Dd]|[Xx]-[Aa][Gg][Ee][Nn][Tt]-[Nn][Aa][Mm][Ee]|[Xx]-[Ss][Hh][Aa][Rr][Ee]-[Tt][Oo][Kk][Ee][Nn]|[Xx]-[Kk][Aa][Gg][Ee][Nn][Tt]-[Ii][Nn][Ss][Ee][Cc][Uu][Rr][Ee]-[Rr][Uu][Nn][Tt][Ii][Mm][Ee]-[Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy])$"}, "description": "the header that carries the token; empty is Authorization, with Bearer <token>; never a reserved name Agent Kourier does not fill with a secret (Proxy-Authorization, Cookie, X-User-Id, X-Agent-Name, X-Share-Token, X-Kagent-Insecure-Runtime-Identity), in any case"}
              }
            },
            "store": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {"enum": ["sqlite", "postgres"]},
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"dsnSecret": {"$ref": "#/definitions/secretKey"}}
                }
              }
            },
            "leaderElection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "leaseDuration": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
                "renewDeadline": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"},
                "retryPeriod": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"}
              }
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": {"type": "string"},
                "size": {"type": "string"},
                "storageClassName": {"type": "string"},
                "accessModes": {"type": "array", "items": {"type": "string"}},
                "retainOnUninstall": {"type": "boolean"}
              }
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "egress to the model's provider on 443: Bedrock (and STS) or the Anthropic API",
                  "properties": {"cidrs": {"type": "array", "items": {"type": "string"}}, "except": {"type": "array", "items": {"type": "string"}}}
                },
                "postgres": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"to": {"type": "array"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
                },
                "extraEgress": {"type": "array"}
              }
            },
            "extraEnv": {"type": "array"},
            "resources": {"type": "object"},
            "podAnnotations": {"type": "object"},
            "podLabels": {"type": "object"},
            "nodeSelector": {"type": "object"},
            "tolerations": {"type": "array"},
            "affinity": {"type": "object"},
            "podSecurityContext": {"type": "object"},
            "securityContext": {"type": "object"}
          }
        }
      }
    }
  },
  "definitions": {
    "secretKey": {
      "description": "a Secret in the release namespace, by name, and one of its keys",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$", "maxLength": 253},
        "key": {"type": "string", "pattern": "^[-._a-zA-Z0-9]*$", "maxLength": 253}
      }
    },
    "durationOrZero": {"type": "string", "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)?$", "description": "empty for the add-on's default, 0, or a Go duration"},
    "labelKey": {"type": "string", "maxLength": 317, "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$", "description": "a label key: an optional DNS subdomain prefix and a slash, then a name of at most 63 characters"},
    "labelValue": {"type": "string", "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$", "description": "a label value: at most 63 characters, empty allowed"},
    "labelSelectorRequirement": {
      "description": "one matchExpressions entry: In and NotIn need values, Exists and DoesNotExist take none",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operator"],
      "properties": {"key": {"$ref": "#/definitions/labelKey"}, "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]}, "values": {"type": "array", "items": {"$ref": "#/definitions/labelValue"}}},
      "if": {"properties": {"operator": {"enum": ["In", "NotIn"]}}},
      "then": {"required": ["values"], "properties": {"values": {"minItems": 1}}},
      "else": {"properties": {"values": {"maxItems": 0}}}
    },
    "resources": {
      "description": "Agent Kourier resources keyed by name: each has a spec, and optionally a namespace (default: the release's)",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec"],
        "properties": {"namespace": {"type": "string"}, "spec": {"type": "object"}}
      }
    }
  }
}
